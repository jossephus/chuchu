<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:label="@string/plugin_name">

        <!-- Identity chuchu reads before loading any code. -->
        <meta-data android:name="chuchu.plugin.id" android:value="hello" />
        <meta-data
            android:name="chuchu.plugin.entry"
            android:value="com.jossephus.chuchu.example.hello.HelloPlugin" />
        <meta-data android:name="chuchu.plugin.apiVersion" android:value="1" />

        <!--
            Discovery marker: chuchu finds plugins by this intent action. There's no LAUNCHER
            category, so the plugin never shows up in the app drawer. If something opens it
            anyway, it explains where the plugin lives.
        -->
        <activity
            android:name=".AboutActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.Dialog">
            <intent-filter>
                <action android:name="com.jossephus.chuchu.PLUGIN" />
            </intent-filter>
        </activity>
    </application>

</manifest>
